#define VS_VERSION_INFO 1
#define VS_FF_DEBUG 0x00000001L
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_DLL 0x00000002L

#define DSK_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define DSK_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define DSK_VERSION_PATCH @PROJECT_VERSION_PATCH@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DSK_VERSION_MAJOR,DSK_VERSION_MINOR,DSK_VERSION_PATCH,0
 PRODUCTVERSION DSK_VERSION_MAJOR,DSK_VERSION_MINOR,DSK_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DSK\0"
      VALUE "FileDescription", "DSK Multistream OBS Plugin\0"
      VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
      VALUE "InternalName", "obs-dsk-multistream\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 DSK\0"
      VALUE "OriginalFilename", "obs-dsk-multistream.dll\0"
      VALUE "ProductName", "DSK Multistream\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
