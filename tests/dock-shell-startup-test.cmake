if(NOT DEFINED SOURCE_ROOT)
  message(FATAL_ERROR "SOURCE_ROOT is required")
endif()
file(READ "${SOURCE_ROOT}/src/plugin-main.cpp" plugin)
file(READ "${SOURCE_ROOT}/src/integration/comment-viewer-integration.cpp" comments)

string(FIND "${plugin}" "void registerFrontendDockShells()" shells_start)
string(FIND "${plugin}" "void ensureMainDockRegistered()" shells_end)
if(shells_start EQUAL -1 OR shells_end LESS shells_start)
  message(FATAL_ERROR "Lightweight dock shells must be registered before OBS restores its window state")
endif()
math(EXPR shells_length "${shells_end} - ${shells_start}")
string(SUBSTRING "${plugin}" ${shells_start} ${shells_length} shells)
foreach(forbidden IN ITEMS "OutputManager>" "new dsk::MainDock" "prepareVerticalCanvas" "loadEditor()" "->initialize()")
  string(FIND "${shells}" "${forbidden}" found)
  if(NOT found EQUAL -1)
    message(FATAL_ERROR "Early dock-shell registration must not initialize runtime content: ${forbidden}")
  endif()
endforeach()
foreach(required IN ITEMS "mainDockHost" "verticalDock" "horizontalDock" "prepareDockShell()")
  string(FIND "${shells}" "${required}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Early startup must register every available DSK dock shell: ${required}")
  endif()
endforeach()
if(NOT plugin MATCHES "void obs_module_post_load\\(\\)\n\\{\n\tregisterFrontendDockShells\\(\\);\n\\}")
  message(FATAL_ERROR "Dock shells must be registered synchronously during module post-load, before OBS restoreState")
endif()
if(NOT plugin MATCHES "if \\(!frontendUiInitialized \\|\\| !shouldCreateDocks\\(\\)")
  message(FATAL_ERROR "A restored shell must not load its editor before OBS finishes loading")
endif()
if(NOT comments MATCHES "void CommentViewerIntegration::prepareDockShell\\(\\)")
  message(FATAL_ERROR "The comment dock needs a shell-only phase separate from browser discovery")
endif()
if(plugin MATCHES "restoreRegisteredDockState" OR comments MATCHES "restoreRegisteredDockState")
  message(FATAL_ERROR "Do not restore individual docks after OBS registration has discarded their placeholders")
endif()
